# ============================================================
# aikanhub local dev environment
# 复制为 .env.local 后即可直接用于本地 Docker 开发。
# 这个文件已在 .gitignore 里，不要提交。
# ============================================================

# --- 数据库（本地 PostgreSQL）---
# docker-compose.local.yml 会启动 postgres 服务。
# 本地开发必须使用这个本地库，不要填生产 Neon/NDB 连接串。
POSTGRES_USER=aikanhub
POSTGRES_PASSWORD=aikanhub_dev_password
POSTGRES_DB=aikanhub
SQL_DSN=postgresql://aikanhub:aikanhub_dev_password@postgres:5432/aikanhub?sslmode=disable

# --- Go module 下载 ---
# 如果 proxy.golang.org 在本地网络不稳定，可以改成 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct

# --- Redis（本地 Docker）---
# 这个值要和 docker-compose.local.yml 里的密码一致。已经预填好，无需修改。
REDIS_CONN_STRING=redis://:3070f09bd424ef9d1bedd3e035616fd7@redis:6379

# --- 会话密钥 ---
# 已生成随机值，无需修改。多机部署时所有节点必须用同一个值。
SESSION_SECRET=daf477b4e94c38c983ff5f4268a5fa6d5fa3be4e6277d7c8bc61476d33393a42

# --- 通用配置 ---
TZ=Asia/Shanghai
PORT=3000
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=aikanhub-dev-1

# --- 视频任务相关（Seedance 走异步任务，建议开）---
# 任务调度器（轮询上游任务状态）
UPDATE_TASK=true
# 流式请求超时（视频生成不是流式，但 chat 类上游会用）
STREAMING_TIMEOUT=300

# --- 调试（按需打开）---
# DEBUG=true
# ENABLE_PPROF=true
