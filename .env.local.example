# ============================================================
# kittyvibe local dev environment
# 复制为 .env.local 后即可直接用于本地 Docker 开发。
# 这个文件已在 .gitignore 里，不要提交。
# ============================================================

# --- 数据库（Neon PostgreSQL 本地开发分支）---
# 本地开发使用专用 Neon branch。不要填生产 Neon/NDB 连接串。
# 复制为 .env.local 后，只在本地文件中填写连接串，不要提交。
SQL_DSN=

# --- Go module 下载 ---
# 如果 proxy.golang.org 在本地网络不稳定，可以改成 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct

# --- Redis（本地 Docker）---
# REDIS_PASSWORD 单独给本地 Redis 容器使用。
# REDIS_CONN_STRING 给应用连接 Redis 使用，两者密码必须一致。
REDIS_PASSWORD=change-me-local-redis-password
REDIS_CONN_STRING=redis://:change-me-local-redis-password@redis:6379

# --- 会话密钥 ---
# 本地开发请生成自己的随机值；多机部署时所有节点必须用同一个值。
SESSION_SECRET=change-me-local-session-secret

# --- 通用配置 ---
TZ=Asia/Shanghai
PORT=3000
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=kittyvibe-dev-1

# --- 视频任务相关（Seedance 走异步任务，建议开）---
# 任务调度器（轮询上游任务状态）
UPDATE_TASK=true
# 流式请求超时（视频生成不是流式，但 chat 类上游会用）
STREAMING_TIMEOUT=300

# --- 调试（按需打开）---
# DEBUG=true
# ENABLE_PPROF=true
